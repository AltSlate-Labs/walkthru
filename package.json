{
  "name": "@altslate/walkthru",
  "version": "0.1.1",
  "description": "Local-first Loom replacement for camera + screen recording",
  "main": "dist-electron/main/index.js",
  "license": "MIT",
  "author": "AltSlate Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltSlate-Labs/walkthru.git"
  },
  "bugs": {
    "url": "https://github.com/AltSlate-Labs/walkthru/issues"
  },
  "homepage": "https://github.com/AltSlate-Labs/walkthru#readme",
  "keywords": [
    "loom-replacement",
    "screen-recorder",
    "face-recorder",
    "electron",
    "react",
    "privacy"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "dist-electron",
    "public/icon.png",
    "README.md",
    "LICENSE",
    "ss1.png",
    "ss2.png",
    "ss3.png",
    "ss4.png"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "build:package": "tsc && vite build",
    "build:app": "npm run build:package && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write src/",
    "prepack": "npm run build:package"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^2.1.8",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.walkthru.app",
    "productName": "Walkthru",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
